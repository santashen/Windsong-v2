# 生产环境变量配置
# 复制此文件为 .env 并填写实际值

# 数据库配置
DB_USER=windsong
DB_PASSWORD=your_secure_password_here
DB_NAME=windsong

# 后台管理 API Key
ADMIN_API_KEY=your_admin_api_key_here

# 文章仓库地址
POSTS_REPO_URL=git@github.com:your-org/your-posts-repo.git

# Python photo metadata parser
LLM_API_URL=https://api.example.com
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=your_supported_fast_model
LLM_TIMEOUT_SECONDS=150
PYTHON_SERVICE_TIMEOUT_SECONDS=160

# RSS 订阅
SITE_URL=https://v2.windsong.top
RSS_TITLE=Windsong Blog
RSS_DESCRIPTION=Windsong Blog RSS Feed
# RSS 2.0 author 建议填写邮箱地址；不需要时留空
RSS_AUTHOR=
RSS_MAX_ITEMS=20

# GitHub Token (用于拉取私有镜像)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
