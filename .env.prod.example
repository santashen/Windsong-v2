# 生产环境变量配置
# 复制此文件为 .env 并填写实际值

# 数据库配置
DB_USER=windsong
DB_PASSWORD=your_secure_password_here
DB_NAME=windsong

# 投资组合页面访问密码
PORTFOLIO_ACCESS_PASSWORD=your_portfolio_access_password_here

# 后台管理 API Key
ADMIN_API_KEY=your_admin_api_key_here

# 文章仓库地址
POSTS_REPO_URL=git@github.com:your-org/your-posts-repo.git

# RSS 订阅
SITE_URL=https://v2.windsong.top
RSS_TITLE=Windsong Blog
RSS_DESCRIPTION=Windsong Blog RSS Feed
# RSS 2.0 author 建议填写邮箱地址；不需要时留空
RSS_AUTHOR=
RSS_MAX_ITEMS=20

# GitHub Token (用于拉取私有镜像)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# LLM API 配置 (AI 服务)
LLM_API_URL=https://api.aaai.vip
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-search-preview

# AkShare 代理配置 (AI 服务)
AKSHARE_PROXY_HOST=101.201.173.125
AKSHARE_PROXY_TOKEN=your_akshare_proxy_token_here
AKSHARE_PROXY_RETRY=30
