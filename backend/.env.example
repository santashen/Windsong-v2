# 服务器配置
PORT=8080

# 数据库配置
DATABASE_URL=host=localhost user=windsong password=windsong123 dbname=windsong port=5432 sslmode=disable

# 环境
ENV=development

# Admin API Key (用于照片管理接口，生产环境必须设置)
# 可以使用 openssl rand -hex 32 生成
ADMIN_API_KEY=

# 博客文章配置
# Git 仓库 URL (存放 markdown 文章的仓库)
POSTS_REPO_URL=https://github.com/username/posts.git
# 本地存储目录
POSTS_DIR=./data/posts
